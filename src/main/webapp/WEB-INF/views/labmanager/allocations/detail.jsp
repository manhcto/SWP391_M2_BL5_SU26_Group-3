<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="app" uri="/WEB-INF/app.tld" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Duyệt yêu cầu cấp phát | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mentor-dashboard.css?v=allocation-20260824"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/equipment-allocation.css?v=allocation-20260824"></head>
<body class="lab-manager-page"><c:set var="activeMenu" value="allocations" scope="request"/><div class="app-shell"><%@ include file="../includes/sidebar.jspf" %><main class="main-content"><header class="topbar"><div class="heading-wrap"><button class="menu-button" id="menuButton" type="button" aria-label="Mở thanh điều hướng"><svg><use href="#i-menu"/></svg></button><div><h1>Duyệt yêu cầu cấp phát</h1><p><c:out value="${allocationRequest.activityName}"/> · <c:out value="${allocationRequest.targetName}"/></p></div></div></header>
<section class="content-area allocation-detail-page"><a class="allocation-back-link" href="${pageContext.request.contextPath}/lab-manager/allocations">Quay lại danh sách</a><c:if test="${not empty param.error}"><p class="error-message" role="alert"><c:out value="${param.error}"/></p></c:if><c:if test="${param.success == '1'}"><p class="success-message" role="status">Đã duyệt và gán đủ thiết bị vật lý.</p></c:if><article class="panel allocation-stock-panel"><header class="panel-header allocation-detail-header"><div class="panel-title"><span class="title-icon allocation-return-icon"><svg><use href="#i-box"/></svg></span><div><span class="allocation-eyebrow">YÊU CẦU CẤP PHÁT</span><h3><c:out value="${allocationRequest.assetName}"/></h3><p><c:out value="${allocationRequest.assetCode}"/> · cấp cho <c:out value="${allocationRequest.targetName}"/></p></div></div><div class="stock-summary ${fn:length(availableItems) < allocationRequest.requestedQuantity ? 'is-short' : ''}"><span>Thiết bị sẵn sàng</span><strong><c:out value="${fn:length(availableItems)}"/></strong><b>/ <c:out value="${allocationRequest.requestedQuantity}"/> cần cấp</b></div></header><form id="approvalForm" method="post" data-required="${allocationRequest.requestedQuantity}"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="approve"><input type="hidden" name="requestId" value="${allocationRequest.allocationRequestId}"><div class="allocation-stock-toolbar"><div><span class="allocation-toolbar-label">Chọn từng thiết bị vật lý</span><p id="selectionCount">Đã chọn 0/<c:out value="${allocationRequest.requestedQuantity}"/> thiết bị</p></div><button class="btn-secondary" id="selectRequired" type="button" ${fn:length(availableItems) < allocationRequest.requestedQuantity || allocationRequest.status != 'PENDING_APPROVAL' ? 'disabled' : ''}>Chọn đủ số lượng</button></div><div class="table-scroll allocation-table-scroll"><table><thead><tr><th>Chọn</th><th>ID thiết bị</th><th>Mã thiết bị</th><th>Serial</th><th>Tình trạng</th></tr></thead><tbody><c:choose><c:when test="${empty availableItems}"><tr><td class="empty-table" colspan="5">Không còn thiết bị vật lý khả dụng.</td></tr></c:when><c:otherwise><c:forEach items="${availableItems}" var="item"><tr class="allocation-item-row"><td><input type="checkbox" name="assetItemId" value="${item.assetItemId}" aria-label="Chọn thiết bị ${item.itemCode}"></td><td>#<c:out value="${item.assetItemId}"/></td><td><strong><c:out value="${item.itemCode}"/></strong></td><td><c:choose><c:when test="${empty item.serialNumber}"><span class="muted-value">Chưa có serial</span></c:when><c:otherwise><c:out value="${item.serialNumber}"/></c:otherwise></c:choose></td><td><span class="allocation-status allocation-status-good"><c:out value="${app:label(item.condition)}"/></span></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div><p class="field-error allocation-stock-error" id="stockError" role="alert"><c:if test="${fn:length(availableItems) < allocationRequest.requestedQuantity}">Tồn kho chưa đủ. Cần bổ sung thêm <c:out value="${allocationRequest.requestedQuantity - fn:length(availableItems)}"/> thiết bị khả dụng trước khi duyệt.</c:if></p><div class="allocation-approval-footer"><label class="allocation-field"><span>Ghi chú duyệt</span><input class="form-control" name="reviewNote" maxlength="500" value="<c:out value='${allocationRequest.note}'/>" placeholder="Ghi chú cho lần cấp phát"></label><button class="primary-button" type="submit" ${fn:length(availableItems) < allocationRequest.requestedQuantity || allocationRequest.status != 'PENDING_APPROVAL' ? 'disabled' : ''}>Duyệt và tạo bàn giao</button></div></form></article></section></main></div><script>
const form=document.getElementById('approvalForm');const required=Number(form.dataset.required);const boxes=[...form.querySelectorAll('[name="assetItemId"]')];const count=document.getElementById('selectionCount');const error=document.getElementById('stockError');const submit=form.querySelector('[type="submit"]');const update=()=>{const selected=boxes.filter(box=>box.checked).length;count.textContent=`Đã chọn ${selected}/${required} thiết bị`;boxes.forEach(box=>{box.disabled=!box.checked&&selected>=required;});if(selected===required){error.textContent='';error.classList.remove('visible');}};boxes.forEach(box=>box.addEventListener('change',update));document.getElementById('selectRequired').addEventListener('click',()=>{boxes.forEach((box,index)=>box.checked=index<required);update();});form.addEventListener('submit',event=>{const selected=boxes.filter(box=>box.checked).length;if(selected!==required){event.preventDefault();error.textContent=`Phải chọn đúng ${required} thiết bị vật lý khác nhau.`;error.classList.add('visible');return;}submit.disabled=true;submit.textContent='Đang duyệt...';});update();
</script></body></html>
