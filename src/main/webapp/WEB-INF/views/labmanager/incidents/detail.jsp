<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="app" uri="/WEB-INF/app.tld" %>
<!DOCTYPE html>
<html lang="vi">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sự cố #INC-${incident.incidentId} | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mentor-dashboard.css"></head>
<body class="lab-manager-page">
<c:set var="activeMenu" value="incidents" scope="request"/>
<div class="app-shell">
    <%@ include file="../includes/sidebar.jspf" %>
    <main class="main-content">
        <header class="topbar"><div class="heading-wrap"><button class="menu-button" id="menuButton" type="button" aria-label="Mở thanh điều hướng"><svg><use href="#i-menu"/></svg></button><div><h1>Sự cố #INC-${incident.incidentId}</h1><p>Điều tra và ghi nhận đánh giá kỹ thuật</p></div></div><div class="topbar-actions"><a class="btn-secondary" href="${pageContext.request.contextPath}/lab-manager/incidents">‹ Quay lại danh sách</a></div></header>
        <section class="content-area">
            <c:if test="${not empty message}"><div class="error-message"><c:out value="${message}"/></div></c:if>
            <c:if test="${param.updated == '1'}"><div class="success-message">Đã cập nhật sự cố.</div></c:if>
            <div class="content-heading"><div><p class="eyebrow">ĐIỀU TRA SỰ CỐ</p><h2><c:out value="${incident.assetName}"/></h2></div><span class="status ${incident.status == 'FORWARDED' || incident.status == 'OPEN' ? 'open' : incident.status == 'RESOLVED' || incident.status == 'CLOSED' ? 'returned' : 'review'}"><c:out value="${app:label(incident.status)}"/></span></div>
            <dl class="panel detail-grid"><div class="detail-item"><dt>Thiết bị</dt><dd><strong><c:out value="${incident.assetName}"/></strong><br><c:out value="${empty incident.assetItemCode ? incident.assetCode : incident.assetItemCode}"/></dd></div><div class="detail-item"><dt>Người báo cáo</dt><dd><c:out value="${incident.reporterName}"/> · <c:out value="${app:label(incident.reporterRole)}"/></dd></div><div class="detail-item"><dt>Thực tập sinh liên quan</dt><dd><c:out value="${empty incident.internName ? '—' : incident.internName}"/><c:if test="${not empty incident.internCode}"><br><small><c:out value="${incident.internCode}"/></small></c:if></dd></div><div class="detail-item"><dt>Loại / mức độ báo cáo</dt><dd><c:out value="${app:label(incident.incidentType)}"/> · <c:out value="${app:label(incident.severity)}"/></dd></div><div class="detail-item"><dt>Thời điểm báo</dt><dd><c:out value="${app:dateTime(incident.reportedAt)}"/></dd></div><div class="detail-item"><dt>Mentor duyệt</dt><dd><c:out value="${empty incident.reviewerName ? 'Báo cáo trực tiếp / lịch sử' : incident.reviewerName}"/><c:if test="${not empty incident.forwardedAt}"><br><small><c:out value="${app:dateTime(incident.forwardedAt)}"/></small></c:if></dd></div><div class="detail-item wide"><dt>Mô tả báo cáo</dt><dd><c:out value="${incident.description}"/></dd></div><c:if test="${not empty incident.mentorReviewNote}"><div class="detail-item wide"><dt>Ghi chú Mentor</dt><dd><c:out value="${incident.mentorReviewNote}"/></dd></div></c:if><c:if test="${not empty incident.investigationNote}"><div class="detail-item wide"><dt>Ghi chú điều tra trước đây</dt><dd><c:out value="${incident.investigationNote}"/></dd></div></c:if><c:if test="${not empty incident.technicalCause}"><div class="detail-item"><dt>Nguyên nhân kỹ thuật</dt><dd><c:out value="${app:label(incident.technicalCause)}"/></dd></div><div class="detail-item"><dt>Mức độ kỹ thuật</dt><dd><c:out value="${app:label(incident.technicalSeverity)}"/></dd></div><div class="detail-item"><dt>Khả năng sửa chữa</dt><dd><c:out value="${app:label(incident.repairability)}"/></dd></div><div class="detail-item"><dt>Hướng xử lý</dt><dd><c:out value="${app:label(incident.recommendedAction)}"/></dd></div><div class="detail-item"><dt>Đánh giá bởi</dt><dd><c:out value="${empty incident.technicalAssessorName ? '—' : incident.technicalAssessorName}"/><br><small><c:out value="${app:dateTime(incident.technicalAssessedAt)}"/></small></dd></div><div class="detail-item wide"><dt>Ghi chú kỹ thuật</dt><dd><c:out value="${incident.technicalNote}"/></dd></div></c:if><div class="detail-item wide"><dt>Kết quả xử lý</dt><dd><c:out value="${empty incident.handlingResult ? 'Chưa có kết quả xử lý.' : incident.handlingResult}"/></dd></div></dl>
            <c:if test="${incident.status == 'FORWARDED'}"><article class="panel"><header class="panel-header"><div class="panel-title"><span class="title-icon"><svg><use href="#i-alert"/></svg></span><h3>Tiếp nhận điều tra</h3></div></header><form class="form-grid" method="post" action="${pageContext.request.contextPath}/lab-manager/incidents/${incident.incidentId}"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="incidentId" value="${incident.incidentId}"><input type="hidden" name="status" value="INVESTIGATING"><div class="form-group full-width"><p>Chuyển sự cố sang trạng thái đang điều tra. Kết luận kỹ thuật được ghi khi giải quyết sự cố.</p></div><div class="form-group full-width form-actions"><button class="primary-button" type="submit">Bắt đầu điều tra</button></div></form></article></c:if>
            <c:if test="${incident.status == 'INVESTIGATING'}"><article class="panel"><header class="panel-header"><div class="panel-title"><span class="title-icon"><svg><use href="#i-alert"/></svg></span><h3>Kết luận kỹ thuật</h3></div></header><form class="form-grid" method="post" action="${pageContext.request.contextPath}/lab-manager/incidents/${incident.incidentId}"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="incidentId" value="${incident.incidentId}"><input type="hidden" name="status" value="RESOLVED"><div class="form-group"><label for="technicalCause">Nguyên nhân kỹ thuật *</label><select class="form-control" id="technicalCause" name="technicalCause" required><option value="">-- Chọn nguyên nhân --</option><option value="NATURAL_WEAR" ${param.technicalCause == 'NATURAL_WEAR' ? 'selected' : ''}>Hao mòn tự nhiên</option><option value="EQUIPMENT_FAILURE" ${param.technicalCause == 'EQUIPMENT_FAILURE' ? 'selected' : ''}>Lỗi thiết bị</option><option value="ACCIDENTAL_DAMAGE" ${param.technicalCause == 'ACCIDENTAL_DAMAGE' ? 'selected' : ''}>Hư hỏng ngoài ý muốn</option><option value="MISUSE" ${param.technicalCause == 'MISUSE' ? 'selected' : ''}>Sử dụng sai cách</option><option value="PROCEDURE_VIOLATION" ${param.technicalCause == 'PROCEDURE_VIOLATION' ? 'selected' : ''}>Vi phạm quy trình</option><option value="LOSS" ${param.technicalCause == 'LOSS' ? 'selected' : ''}>Mất thiết bị</option><option value="UNKNOWN" ${param.technicalCause == 'UNKNOWN' ? 'selected' : ''}>Chưa xác định</option></select></div><div class="form-group"><label for="technicalSeverity">Mức độ kỹ thuật *</label><select class="form-control" id="technicalSeverity" name="technicalSeverity" required><option value="">-- Chọn mức độ --</option><option value="MINOR" ${param.technicalSeverity == 'MINOR' ? 'selected' : ''}>Nhẹ</option><option value="MODERATE" ${param.technicalSeverity == 'MODERATE' ? 'selected' : ''}>Trung bình</option><option value="MAJOR" ${param.technicalSeverity == 'MAJOR' ? 'selected' : ''}>Nghiêm trọng</option><option value="CRITICAL" ${param.technicalSeverity == 'CRITICAL' ? 'selected' : ''}>Nghiêm trọng đặc biệt</option></select></div><div class="form-group"><label for="repairability">Khả năng sửa chữa *</label><select class="form-control" id="repairability" name="repairability" required><option value="">-- Chọn đánh giá --</option><option value="REPAIRABLE" ${param.repairability == 'REPAIRABLE' ? 'selected' : ''}>Có thể sửa chữa</option><option value="NOT_REPAIRABLE" ${param.repairability == 'NOT_REPAIRABLE' ? 'selected' : ''}>Không thể sửa chữa</option><option value="NOT_APPLICABLE" ${param.repairability == 'NOT_APPLICABLE' ? 'selected' : ''}>Không áp dụng</option></select></div><div class="form-group"><label for="recommendedAction">Hướng xử lý *</label><select class="form-control" id="recommendedAction" name="recommendedAction" required><option value="">-- Chọn hướng xử lý --</option><option value="CONTINUE_USE" ${param.recommendedAction == 'CONTINUE_USE' ? 'selected' : ''}>Tiếp tục sử dụng</option><option value="MONITOR" ${param.recommendedAction == 'MONITOR' ? 'selected' : ''}>Theo dõi</option><option value="MAINTENANCE" ${param.recommendedAction == 'MAINTENANCE' ? 'selected' : ''}>Bảo trì</option><option value="REMOVE_FROM_USE" ${param.recommendedAction == 'REMOVE_FROM_USE' ? 'selected' : ''}>Ngừng sử dụng</option><option value="DISPOSAL_REVIEW" ${param.recommendedAction == 'DISPOSAL_REVIEW' ? 'selected' : ''}>Xem xét thanh lý</option></select></div><div class="form-group full-width"><label for="technicalNote">Ghi chú kỹ thuật *</label><textarea class="form-control" id="technicalNote" name="technicalNote" rows="4" maxlength="2000" required placeholder="Mô tả kiểm tra, bằng chứng và kết luận kỹ thuật."><c:out value="${param.technicalNote}"/></textarea></div><div class="form-group full-width"><label for="handlingResult">Kết quả xử lý *</label><textarea class="form-control" id="handlingResult" name="handlingResult" rows="4" maxlength="2000" required placeholder="Nêu kết quả xử lý hoặc hành động cần tiếp tục."><c:out value="${param.handlingResult}"/></textarea></div><div class="form-group full-width form-actions"><button class="primary-button" type="submit">Ghi nhận kết luận và giải quyết</button></div></form></article></c:if>
            <c:if test="${incident.status == 'RESOLVED'}"><article class="panel"><header class="panel-header"><div class="panel-title"><span class="title-icon"><svg><use href="#i-alert"/></svg></span><h3>Đóng sự cố</h3></div></header><form class="form-grid" method="post" action="${pageContext.request.contextPath}/lab-manager/incidents/${incident.incidentId}"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="incidentId" value="${incident.incidentId}"><input type="hidden" name="status" value="CLOSED"><div class="form-group full-width"><p>Đóng hồ sơ sau khi kiểm tra kết luận kỹ thuật và kết quả xử lý.</p></div><div class="form-group full-width form-actions"><button class="primary-button" type="submit">Đóng sự cố</button></div></form></article></c:if>
            <c:if test="${incident.status == 'OPEN'}"><p class="error-message">Bản ghi lịch sử OPEN chỉ có thể xem. Không thể chuyển sang workflow mới tự động.</p></c:if>
            <c:if test="${incident.status == 'CLOSED'}"><p class="success-message">Sự cố đã đóng. Hồ sơ chỉ có thể xem.</p></c:if>
        </section>
    </main>
</div>
</body>
</html>
