<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Asset Disposal | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell">
<aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Operations portal</small></div></div><p class="nav-label">Asset lifecycle</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/usages"><span class="nav-icon">↗</span>Asset usage</a><a class="nav-link active" href="${pageContext.request.contextPath}/lab-manager/disposals"><span class="nav-icon">◇</span>Asset disposal</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Asset Disposal (FE-09)</strong><small>Controlled asset retirement</small></div><div class="user-chip"><span class="avatar">LM</span><span>Lab Manager</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">Disposal directory</p><h1>Asset Disposal</h1><p>Review pending processes and preserve a complete history of retired assets.</p></div><div class="actions"><a class="button primary" href="${pageContext.request.contextPath}/lab-manager/disposals/new">＋ Create disposal</a></div></div>
<form class="card filter-bar" method="get"><input class="form-control" name="keyword" value="<c:out value='${param.keyword}'/>" placeholder="Search asset name or code"><select class="form-select" name="status"><option value="">All statuses</option><option value="PENDING" ${param.status == 'PENDING' ? 'selected' : ''}>Pending</option><option value="CANCELLED" ${param.status == 'CANCELLED' ? 'selected' : ''}>Cancelled</option><option value="COMPLETED" ${param.status == 'COMPLETED' ? 'selected' : ''}>Completed</option></select><div class="actions"><button class="button primary">Filter</button><a class="button" href="${pageContext.request.contextPath}/lab-manager/disposals">Reset</a></div></form>
<section class="card table-card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Disposal ID</th><th>Asset</th><th>Quantity</th><th>Requested by</th><th>Requested at</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${disposals}" var="d"><tr><td>#DSP-${d.disposalId}</td><td class="asset-cell"><strong><c:out value="${d.assetName}"/></strong><small><c:out value="${d.assetCode}"/></small></td><td>${d.quantity}</td><td><c:out value="${d.requesterName}"/></td><td>${d.requestedAt}</td><td><span class="badge ${d.status == 'PENDING' ? 'pending' : d.status == 'COMPLETED' ? 'completed' : 'cancelled'}">${d.status}</span></td><td><a class="table-link" href="${pageContext.request.contextPath}/lab-manager/disposals/${d.disposalId}">View</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty disposals}"><div class="empty-state">No disposal records match this filter.</div></c:if></section>
</main></div></div></body></html>
