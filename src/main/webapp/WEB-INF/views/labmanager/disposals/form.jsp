<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create Disposal | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell">
<aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Operations portal</small></div></div><p class="nav-label">Asset lifecycle</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/usages"><span class="nav-icon">↗</span>Asset usage</a><a class="nav-link active" href="${pageContext.request.contextPath}/lab-manager/disposals"><span class="nav-icon">◇</span>Asset disposal</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Create Disposal</strong><small>Start a controlled retirement process</small></div><div class="user-chip"><span class="avatar">LM</span><span>Lab Manager</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">New disposal process</p><h1>Retire an Asset</h1><p>Disposal applies to the entire logical asset record and its full quantity.</p></div><a class="button" href="${pageContext.request.contextPath}/lab-manager/disposals">← Back to disposal</a></div><p class="alert" role="alert"><c:out value="${message}"/></p>
<section class="card form-card"><div class="card-body"><form method="post"><input type="hidden" name="action" value="create"><div class="mb-3"><label class="form-label" for="assetId">Eligible asset</label><select class="form-select" id="assetId" name="assetId" required><c:forEach items="${assets}" var="a"><option value="${a.assetId}"><c:out value="${a.assetCode}"/> · <c:out value="${a.assetName}"/> · full quantity ${a.totalQuantity}</option></c:forEach></select><div class="form-text">Disposed assets and assets with a pending disposal are excluded.</div></div><div class="mb-4"><label class="form-label" for="reason">Reason for disposal</label><textarea class="form-control" id="reason" name="reason" rows="5" placeholder="Explain why this asset can no longer be safely or effectively used" required></textarea></div><div class="actions"><button class="button primary" type="submit" <c:if test="${empty assets}">disabled</c:if>>Create pending disposal</button><a class="button" href="${pageContext.request.contextPath}/lab-manager/disposals">Cancel</a></div></form><c:if test="${empty assets}"><div class="empty-state">No assets are currently eligible for disposal.</div></c:if></div></section>
</main></div></div></body></html>
