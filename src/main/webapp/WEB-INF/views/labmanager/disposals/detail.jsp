<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Disposal #${disposal.disposalId} | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell">
<aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Operations portal</small></div></div><p class="nav-label">Asset lifecycle</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/usages"><span class="nav-icon">↗</span>Asset usage</a><a class="nav-link active" href="${pageContext.request.contextPath}/lab-manager/disposals"><span class="nav-icon">◇</span>Asset disposal</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Disposal Detail</strong><small>Asset lifecycle record</small></div><div class="user-chip"><span class="avatar">LM</span><span>Lab Manager</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">Disposal #DSP-${disposal.disposalId}</p><h1><c:out value="${disposal.assetName}"/></h1><p><c:out value="${disposal.assetCode}"/> · <span class="badge ${disposal.status == 'PENDING' ? 'pending' : disposal.status == 'COMPLETED' ? 'completed' : 'cancelled'}">${disposal.status}</span></p></div><a class="button" href="${pageContext.request.contextPath}/lab-manager/disposals">← Back to disposal</a></div><p class="alert" role="alert"><c:out value="${message}"/></p>
<dl class="card detail-grid"><div class="detail-item"><dt>Quantity retired</dt><dd>${disposal.quantity}</dd></div><div class="detail-item"><dt>Requested by</dt><dd><c:out value="${disposal.requesterName}"/></dd></div><div class="detail-item"><dt>Requested at</dt><dd>${disposal.requestedAt}</dd></div><div class="detail-item wide"><dt>Reason</dt><dd><c:out value="${disposal.reason}"/></dd></div><div class="detail-item"><dt>Completed at</dt><dd>${empty disposal.completedAt ? 'Not completed' : disposal.completedAt}</dd></div><div class="detail-item wide"><dt>Process note</dt><dd><c:out value="${empty disposal.completionNote ? 'No process note.' : disposal.completionNote}"/></dd></div></dl>
<c:if test="${disposal.status == 'PENDING'}"><div class="row g-4"><div class="col-lg-6"><h2 class="section-title">Update reason</h2><section class="card"><div class="card-body"><form method="post" action="${pageContext.request.contextPath}/lab-manager/disposals"><input type="hidden" name="action" value="update"><input type="hidden" name="disposalId" value="${disposal.disposalId}"><div class="mb-3"><label class="form-label" for="reason">Disposal reason</label><textarea class="form-control" id="reason" name="reason" rows="5" required><c:out value="${disposal.reason}"/></textarea></div><button class="button primary">Save reason</button></form></div></section></div><div class="col-lg-6"><h2 class="section-title">Finish process</h2><section class="card"><div class="card-body"><form method="post" action="${pageContext.request.contextPath}/lab-manager/disposals"><input type="hidden" name="disposalId" value="${disposal.disposalId}"><div class="mb-3"><label class="form-label" for="note">Process note</label><textarea class="form-control" id="note" name="note" rows="5" placeholder="Completion evidence or cancellation reason"></textarea></div><div class="actions"><button class="button danger" name="action" value="cancel">Cancel process</button><button class="button warning" name="action" value="complete">Complete disposal</button></div></form></div></section></div></div></c:if>
</main></div></div></body></html>
