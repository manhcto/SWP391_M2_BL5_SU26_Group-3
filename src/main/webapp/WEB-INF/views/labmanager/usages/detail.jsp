<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Usage #${usage.assetUsageId} | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell">
<aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Operations portal</small></div></div><p class="nav-label">Asset lifecycle</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link active" href="${pageContext.request.contextPath}/lab-manager/usages"><span class="nav-icon">↗</span>Asset usage</a><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/disposals"><span class="nav-icon">◇</span>Asset disposal</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Usage Detail</strong><small>Read-only transaction record</small></div><div class="user-chip"><span class="avatar">LM</span><span>Lab Manager</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">Usage #AU-${usage.assetUsageId}</p><h1><c:out value="${usage.assetName}"/></h1><p><c:out value="${usage.assetCode}"/> · <span class="badge ${usage.status == 'IN_USE' ? 'in-use' : 'returned'}">${usage.status}</span></p></div><a class="button" href="${pageContext.request.contextPath}/lab-manager/usages">← Back to usage</a></div>
<dl class="card detail-grid"><div class="detail-item"><dt>Student</dt><dd><c:out value="${usage.studentName}"/></dd></div><div class="detail-item"><dt>Quantity</dt><dd>${usage.quantity}</dd></div><div class="detail-item"><dt>Status</dt><dd>${usage.status}</dd></div><div class="detail-item"><dt>Borrowed at</dt><dd>${usage.borrowedAt}</dd></div><div class="detail-item"><dt>Due at</dt><dd>${usage.dueAt}</dd></div><div class="detail-item"><dt>Returned at</dt><dd>${empty usage.returnedAt ? 'Not returned' : usage.returnedAt}</dd></div><div class="detail-item"><dt>Condition before</dt><dd>${usage.conditionBefore}</dd></div><div class="detail-item"><dt>Condition after</dt><dd>${empty usage.conditionAfter ? 'Pending return' : usage.conditionAfter}</dd></div><div class="detail-item"><dt>Approved request</dt><dd>#REQ-${usage.requestId}</dd></div><div class="detail-item wide"><dt>Note</dt><dd><c:out value="${empty usage.note ? 'No note recorded.' : usage.note}"/></dd></div></dl>
</main></div></div></body></html>
