<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Asset Usage | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell">
<aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Operations portal</small></div></div><p class="nav-label">Asset lifecycle</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link active" href="${pageContext.request.contextPath}/lab-manager/usages"><span class="nav-icon">↗</span>Asset usage</a><a class="nav-link" href="${pageContext.request.contextPath}/lab-manager/disposals"><span class="nav-icon">◇</span>Asset disposal</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Asset Usage (FE-04)</strong><small>Lab-wide borrowing oversight</small></div><div class="user-chip"><span class="avatar">LM</span><span>Lab Manager</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">Usage directory</p><h1>All Asset Usage</h1><p>Monitor current loans and inspect historical usage across approved students.</p></div></div>
<form class="card filter-bar" method="get"><input class="form-control" name="keyword" value="<c:out value='${param.keyword}'/>" placeholder="Search student, asset name, or code"><select class="form-select" name="status"><option value="">All statuses</option><option value="IN_USE" ${param.status == 'IN_USE' ? 'selected' : ''}>In use</option><option value="RETURNED" ${param.status == 'RETURNED' ? 'selected' : ''}>Returned</option></select><div class="actions"><button class="button primary" type="submit">Filter</button><a class="button" href="${pageContext.request.contextPath}/lab-manager/usages">Reset</a></div></form>
<section class="card table-card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Usage ID</th><th>Student</th><th>Asset</th><th>Quantity</th><th>Borrowed</th><th>Due</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${usages}" var="u"><tr><td>#AU-${u.assetUsageId}</td><td><c:out value="${u.studentName}"/></td><td class="asset-cell"><strong><c:out value="${u.assetName}"/></strong><small><c:out value="${u.assetCode}"/></small></td><td>${u.quantity}</td><td>${u.borrowedAt}</td><td>${u.dueAt}</td><td><span class="badge ${u.status == 'IN_USE' ? 'in-use' : 'returned'}">${u.status}</span></td><td><a class="table-link" href="${pageContext.request.contextPath}/lab-manager/usages/${u.assetUsageId}">View</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty usages}"><div class="empty-state">No usage records match this filter.</div></c:if></section>
</main></div></div></body></html>
