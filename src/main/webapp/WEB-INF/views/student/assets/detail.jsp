<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html>
<html lang="vi">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Chi tiết ${item.itemCode} | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mentor-dashboard.css"><style>.asset-detail{display:grid;grid-template-columns:240px minmax(0,1fr);gap:20px;padding:20px}.asset-detail-image{display:flex;min-height:210px;align-items:center;justify-content:center;border:1px dashed var(--line);border-radius:10px;background:#f5fcfd}.asset-detail-image img{width:100%;max-height:240px;object-fit:contain;border-radius:8px}.asset-detail-image svg{width:62px;height:62px;fill:none;stroke:#087fa0;stroke-width:1.3}.asset-info h3{margin:0;color:var(--ink);font-size:20px}.asset-info p{margin:6px 0 0;color:var(--muted);font-size:11px}.asset-info dl{display:grid;grid-template-columns:150px 1fr;gap:9px;margin:22px 0;font-size:12px}.asset-info dt{color:var(--muted)}.asset-info dd{margin:0;font-weight:600;color:var(--ink)}.detail-actions{display:flex;gap:8px;flex-wrap:wrap}</style></head>
<body class="intern-dashboard-page"><c:set var="activeMenu" value="assets" scope="request"/><div class="app-shell"><%@ include file="../includes/sidebar.jspf" %><main class="main-content"><header class="topbar"><div class="heading-wrap"><button class="menu-button" id="menuButton" type="button" aria-label="Mở thanh điều hướng" aria-controls="sidebar" aria-expanded="false"><svg><use href="#i-menu"/></svg></button><div><h1>Chi tiết thiết bị</h1><p>Thông tin sản phẩm đang sẵn sàng để mượn</p></div></div><div class="topbar-actions"><a class="btn-secondary" href="${assetBasePath}">Quay lại danh sách</a></div></header><section class="content-area"><div class="content-heading"><div><p class="eyebrow">DANH MỤC TÀI SẢN</p><h2><c:out value="${item.itemCode}"/></h2></div></div><article class="panel"><div class="asset-detail"><div class="asset-detail-image"><c:choose><c:when test="${not empty item.imagePath}"><img src="${pageContext.request.contextPath}${item.imagePath}" alt="Ảnh ${item.itemCode}"></c:when><c:otherwise><svg><use href="#i-box"/></svg></c:otherwise></c:choose></div><div class="asset-info"><h3><c:out value="${item.assetName}"/></h3><p><c:out value="${item.assetCode}"/> · <c:out value="${item.categoryName}"/></p><dl><dt>Mã sản phẩm</dt><dd><c:out value="${item.itemCode}"/></dd><dt>Serial</dt><dd><c:out value="${empty item.serialNumber ? 'Không yêu cầu serial' : item.serialNumber}"/></dd><dt>Trạng thái</dt><dd>Sẵn sàng</dd><dt>Ghi chú</dt><dd><c:out value="${empty item.note ? 'Không có' : item.note}"/></dd></dl><div class="detail-actions"><a class="primary-button" href="${pageContext.request.contextPath}/intern/usages/borrow?assetId=${item.assetId}&amp;assetItemId=${item.assetItemId}">Mượn thiết bị</a><a class="btn-secondary" href="${assetBasePath}">Quay lại</a></div></div></div></article></section></main></div></body></html>
