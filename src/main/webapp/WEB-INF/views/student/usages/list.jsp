<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Asset Usage | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell"><main class="content"><div class="page-heading"><div><p class="eyebrow">INTERN PORTAL</p><h1>My Asset Usage</h1><p>Track active loans and return history.</p></div><div class="actions"><a class="button" href="${pageContext.request.contextPath}/intern/dashboard">Dashboard</a><a class="button primary" href="${pageContext.request.contextPath}/intern/usages/borrow">Borrow an asset</a></div></div><p class="alert" role="alert"><c:out value="${message}"/></p><section class="card table-card"><div class="table-wrap"><table><thead><tr><th>Usage ID</th><th>Asset</th><th>Quantity</th><th>Borrowed</th><th>Due</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${usages}" var="u"><tr><td>#AU-${u.assetUsageId}</td><td><strong><c:out value="${u.assetName}"/></strong><small><c:out value="${u.assetCode}"/></small></td><td>${u.quantity}</td><td>${u.borrowedAt}</td><td>${u.dueAt}</td><td>${u.status}</td><td><a class="table-link" href="${pageContext.request.contextPath}/intern/usages/${u.assetUsageId}">View</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty usages}"><div class="empty-state"><strong>No usage records yet.</strong><br>Borrow an asset during your approved semester.</div></c:if></section></main></div></body></html>
