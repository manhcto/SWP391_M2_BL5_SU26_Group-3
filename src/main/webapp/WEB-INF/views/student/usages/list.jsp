<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Asset Usage | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body>
<div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Student portal</small></div></div><p class="nav-label">Workspace</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/student/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link active" href="${pageContext.request.contextPath}/student/usages"><span class="nav-icon">↗</span>My usage</a><a class="nav-link" href="${pageContext.request.contextPath}/student/usages/borrow"><span class="nav-icon">＋</span>Borrow asset</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Asset Usage (FE-04)</strong><small>Borrowing and return history</small></div><div class="user-chip"><span class="avatar">ST</span><span>Student</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">Personal inventory trail</p><h1>My Asset Usage</h1><p>Track active loans, due times, and your complete return history.</p></div><div class="actions"><a class="button primary" href="${pageContext.request.contextPath}/student/usages/borrow">＋ Borrow an asset</a></div></div><p class="alert" role="alert"><c:out value="${message}"/></p>
<section class="card table-card"><div class="table-wrap"><table><thead><tr><th>Usage ID</th><th>Asset</th><th>Quantity</th><th>Borrowed</th><th>Due</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${usages}" var="u"><tr><td>#AU-${u.assetUsageId}</td><td class="asset-cell"><strong><c:out value="${u.assetName}"/></strong><small><c:out value="${u.assetCode}"/></small></td><td>${u.quantity}</td><td>${u.borrowedAt}</td><td>${u.dueAt}</td><td><span class="badge ${u.status == 'IN_USE' ? 'in-use' : 'returned'}">${u.status}</span></td><td><a class="table-link" href="${pageContext.request.contextPath}/student/usages/${u.assetUsageId}">View details</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty usages}"><div class="empty-state"><strong>No usage records yet.</strong><br>Borrow an asset during your approved lab slot.</div></c:if></section>
</main></div></div></body></html>
