<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Borrow Asset | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Student portal</small></div></div><p class="nav-label">Workspace</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/student/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link" href="${pageContext.request.contextPath}/student/usages"><span class="nav-icon">↗</span>My usage</a><a class="nav-link active" href="${pageContext.request.contextPath}/student/usages/borrow"><span class="nav-icon">＋</span>Borrow asset</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Borrow Asset</strong><small>Approved session checkout</small></div><div class="user-chip"><span class="avatar">ST</span><span>Student</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">New transaction</p><h1>Borrow an Asset</h1><p>Available equipment appears only when it is safe and eligible to borrow.</p></div><div class="actions"><a class="button" href="${pageContext.request.contextPath}/student/usages">← Back to usage</a></div></div><p class="alert" role="alert"><c:out value="${message}"/></p>
<section class="card form-card"><form method="post"><input type="hidden" name="action" value="borrow"><div class="field"><label for="assetId">Asset</label><select class="select" id="assetId" name="assetId" required><c:forEach items="${assets}" var="a"><option value="${a.assetId}"><c:out value="${a.assetCode}"/> · <c:out value="${a.assetName}"/> · ${a.totalQuantity} total</option></c:forEach></select><span class="hint">Pending disposal, unavailable, and non-borrowable assets are excluded.</span></div><div class="field"><label for="quantity">Quantity</label><input class="input" id="quantity" type="number" name="quantity" min="1" value="1" required></div><div class="field"><label for="note">Usage note <span class="hint">(optional)</span></label><textarea class="textarea" id="note" name="note" placeholder="Purpose, project, or handling note"></textarea></div><p class="hint">Due time is set automatically to the end of your current approved lab slot.</p><div class="actions"><button class="button primary" type="submit" <c:if test="${empty assets}">disabled</c:if>>Confirm borrow</button><a class="button" href="${pageContext.request.contextPath}/student/usages">Cancel</a></div></form><c:if test="${empty assets}"><div class="empty-state">No eligible assets are available right now.</div></c:if></section>
</main></div></div></body></html>
