<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Usage #${usage.assetUsageId} | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">LA</span><div><strong>LAB ASSET</strong><small>Student portal</small></div></div><p class="nav-label">Workspace</p><nav><a class="nav-link" href="${pageContext.request.contextPath}/student/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link active" href="${pageContext.request.contextPath}/student/usages"><span class="nav-icon">↗</span>My usage</a><a class="nav-link" href="${pageContext.request.contextPath}/student/usages/borrow"><span class="nav-icon">＋</span>Borrow asset</a></nav><div class="sidebar-user"><strong><c:out value="${sessionScope.fullName}"/></strong><small><c:out value="${sessionScope.email}"/></small></div><form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout"><button>↪ Sign out</button></form></aside>
<div class="workspace"><header class="topbar"><div><strong>Usage Detail</strong><small>Transaction record #AU-${usage.assetUsageId}</small></div><div class="user-chip"><span class="avatar">ST</span><span>Student</span></div></header><main class="content"><div class="page-heading"><div><p class="eyebrow">Asset usage record</p><h1><c:out value="${usage.assetName}"/></h1><p><c:out value="${usage.assetCode}"/> · <span class="badge ${usage.status == 'IN_USE' ? 'in-use' : 'returned'}">${usage.status}</span></p></div><div class="actions"><a class="button" href="${pageContext.request.contextPath}/student/usages">← Back to usage</a></div></div>
<dl class="card detail-grid"><div class="detail-item"><dt>Usage ID</dt><dd>#AU-${usage.assetUsageId}</dd></div><div class="detail-item"><dt>Quantity</dt><dd>${usage.quantity}</dd></div><div class="detail-item"><dt>Status</dt><dd>${usage.status}</dd></div><div class="detail-item"><dt>Borrowed at</dt><dd>${usage.borrowedAt}</dd></div><div class="detail-item"><dt>Due at</dt><dd>${usage.dueAt}</dd></div><div class="detail-item"><dt>Returned at</dt><dd>${empty usage.returnedAt ? 'Not returned' : usage.returnedAt}</dd></div><div class="detail-item"><dt>Condition before</dt><dd>${usage.conditionBefore}</dd></div><div class="detail-item"><dt>Condition after</dt><dd>${empty usage.conditionAfter ? 'Pending return' : usage.conditionAfter}</dd></div><div class="detail-item"><dt>Request ID</dt><dd>#REQ-${usage.requestId}</dd></div><div class="detail-item wide"><dt>Note</dt><dd><c:out value="${empty usage.note ? 'No note recorded.' : usage.note}"/></dd></div></dl>
<c:if test="${usage.status == 'IN_USE'}"><h2 class="section-title">Return this asset</h2><section class="card form-card"><form method="post" action="${pageContext.request.contextPath}/student/usages"><input type="hidden" name="action" value="return"><input type="hidden" name="usageId" value="${usage.assetUsageId}"><div class="form-grid"><div class="field"><label for="conditionAfter">Condition after use</label><select class="select" id="conditionAfter" name="conditionAfter" required><option>GOOD</option><option>FAIR</option><option>DAMAGED</option><option>BROKEN</option></select></div><div class="field span-2"><label for="note">Return note</label><textarea class="textarea" id="note" name="note" placeholder="Describe any wear, damage, or issue"></textarea></div></div><button class="button primary" type="submit">Confirm return</button></form></section></c:if>
</main></div></div></body></html>
