<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Usage #${usage.assetUsageId} | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/asset-operations.css"></head><body><div class="app-shell"><main class="content"><div class="page-heading"><div><p class="eyebrow">INTERN PORTAL</p><h1><c:out value="${usage.assetName}"/></h1><p><c:out value="${usage.assetCode}"/> · ${usage.status}</p></div><div class="actions"><a class="button" href="${pageContext.request.contextPath}/intern/usages">Back</a></div></div><dl class="card detail-grid"><div class="detail-item"><dt>Quantity</dt><dd>${usage.quantity}</dd></div><div class="detail-item"><dt>Borrowed at</dt><dd>${usage.borrowedAt}</dd></div><div class="detail-item"><dt>Due at</dt><dd>${usage.dueAt}</dd></div><div class="detail-item"><dt>Status</dt><dd>${usage.status}</dd></div></dl><c:if test="${usage.status == 'IN_USE'}"><h2 class="section-title">Return this asset</h2><section class="card form-card"><form method="post" action="${pageContext.request.contextPath}/intern/usages"><input type="hidden" name="action" value="return"><input type="hidden" name="usageId" value="${usage.assetUsageId}"><div class="field"><label for="conditionAfter">Condition after use</label><select class="select" id="conditionAfter" name="conditionAfter" required><option>GOOD</option><option>FAIR</option><option>DAMAGED</option><option>BROKEN</option></select></div><div class="field"><label for="note">Return note</label><textarea class="textarea" id="note" name="note"></textarea></div><button class="button primary" type="submit">Confirm return</button></form></section></c:if></main></div></body></html>
