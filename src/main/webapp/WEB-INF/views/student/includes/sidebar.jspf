<svg class="svg-sprite" aria-hidden="true">
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="m21 8-9 5-9-5 9-5 9 5Z"/><path d="m3 8 9 5 9-5v9l-9 5-9-5V8Z"/><path d="M12 13v9"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="M10.3 3.7 2.4 17.2A2 2 0 0 0 4.1 20h15.8a2 2 0 0 0 1.7-2.8L13.7 3.7a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/></symbol>
    <symbol id="i-list" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></symbol>
</svg>
<aside class="sidebar" id="sidebar">
    <a class="brand" href="${pageContext.request.contextPath}/intern/dashboard" aria-label="LAB Asset Intern home">
        <span class="brand-mark"><img src="${pageContext.request.contextPath}/assets/images/fpt-university-logo.png" alt="FPT University"></span>
        <span><strong>LAB ASSET</strong><small>INTERN PORTAL</small></span>
    </a>
    <nav class="side-nav" aria-label="Intern navigation">
        <a class="nav-link${activeMenu == 'dashboard' ? ' active' : ''}" href="${pageContext.request.contextPath}/intern/dashboard"><svg><use href="#i-grid"/></svg><span>Dashboard</span></a>
        <a class="nav-link" href="${pageContext.request.contextPath}/intern/usages/borrow"><svg><use href="#i-box"/></svg><span>Borrow Asset</span></a>
        <a class="nav-link" href="${pageContext.request.contextPath}/intern/usages"><svg><use href="#i-calendar"/></svg><span>My Usage History</span></a>
        <a class="nav-link" href="#"><svg><use href="#i-alert"/></svg><span>My Incidents</span></a>
        <a class="nav-link${activeMenu == 'responsibilities' ? ' active' : ''}" href="${pageContext.request.contextPath}/intern/responsibilities"><svg><use href="#i-list"/></svg><span>My Responsibilities</span></a>
    </nav>
    <div class="sidebar-footer">
        <div class="profile-card"><div class="avatar avatar-lg">IN</div><div class="profile-copy"><strong><c:out value="${currentUser.fullName}"/></strong><span><i></i>INTERN</span></div></div>
        <form method="post" action="${pageContext.request.contextPath}/logout"><button class="sign-out" type="submit"><svg><use href="#i-logout"/></svg><span>Log out</span></button></form>
    </div>
</aside>
<button class="sidebar-overlay" id="sidebarOverlay" type="button" aria-label="Close navigation"></button>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuButton = document.getElementById('menuButton');
        const overlay = document.getElementById('sidebarOverlay');
        if (!menuButton || !overlay) return;
        const closeMenu = () => { document.body.classList.remove('nav-open'); menuButton.setAttribute('aria-expanded', 'false'); };
        menuButton.addEventListener('click', () => { const open = document.body.classList.toggle('nav-open'); menuButton.setAttribute('aria-expanded', String(open)); });
        overlay.addEventListener('click', closeMenu);
    });
</script>
