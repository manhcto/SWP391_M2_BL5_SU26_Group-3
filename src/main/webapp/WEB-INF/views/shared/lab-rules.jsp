<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>
<%@ taglib prefix="app" uri="/WEB-INF/app.tld"%>
<c:set var="activeMenu" value="labRules" scope="request"/>
<c:choose>
    <c:when test="${roleBase == '/lab-manager'}"><c:set var="pageClass" value="lab-manager-page"/><c:set var="portalName" value="CỔNG QUẢN LÝ PHÒNG LAB"/></c:when>
    <c:when test="${roleBase == '/mentor'}"><c:set var="pageClass" value="mentor-page"/><c:set var="portalName" value="CỔNG NGƯỜI HƯỚNG DẪN"/></c:when>
    <c:otherwise><c:set var="pageClass" value="intern-dashboard-page"/><c:set var="portalName" value="CỔNG THỰC TẬP SINH"/></c:otherwise>
</c:choose>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Nội quy phòng lab | LAB Asset</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mentor-dashboard.css">
    <style>
        .rules-v2{max-width:1180px;padding-bottom:30px}.rules-v2 *{box-sizing:border-box}.rules-banner{position:relative;overflow:hidden;margin:0 0 18px;padding:26px 28px;border-radius:16px;color:#fff;background:linear-gradient(120deg,#102f4a 0%,#126272 58%,#16916d 100%);box-shadow:0 14px 30px rgba(14,73,91,.18)}.rules-banner:after,.rules-banner:before{position:absolute;border:1px solid rgba(255,255,255,.16);border-radius:50%;content:""}.rules-banner:before{right:-38px;bottom:-98px;width:250px;height:250px}.rules-banner:after{right:130px;top:-105px;width:180px;height:180px}.rules-banner__body{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:24px}.rules-banner__tag{display:inline-block;margin-bottom:10px;padding:5px 10px;border:1px solid rgba(255,255,255,.24);border-radius:999px;background:rgba(255,255,255,.11);font-size:10px;font-weight:800;letter-spacing:.08em}.rules-banner h3{max-width:690px;margin:0 0 7px;font-size:23px;line-height:1.28}.rules-banner p{max-width:680px;margin:0;color:rgba(255,255,255,.84);font-size:12px;line-height:1.65}.rules-banner__stats{display:grid;grid-template-columns:repeat(2,minmax(76px,1fr));gap:8px;min-width:190px}.rules-stat{padding:12px 11px;border:1px solid rgba(255,255,255,.2);border-radius:11px;background:rgba(4,38,52,.2);text-align:center}.rules-stat strong{display:block;font-size:22px;line-height:1.1}.rules-stat span{display:block;margin-top:3px;font-size:9px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}.rules-section{overflow:hidden;margin-top:16px;border:1px solid #d8e8ed;border-radius:14px;background:#fff;box-shadow:0 7px 20px rgba(24,69,85,.06)}.rules-section__head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid #e7f0f2;background:linear-gradient(90deg,#fff,#f3fafb)}.rules-section__mark{display:grid;width:28px;height:28px;place-items:center;border-radius:8px;color:#0c746b;background:#dff4ed;font-size:12px;font-weight:900}.rules-section__head h3{margin:0;color:#18364e;font-size:13px}.rules-section__head p{margin:2px 0 0;color:#72828f;font-size:10px}.rule-cards,.role-cards{display:grid;gap:12px;padding:16px}.rule-cards{grid-template-columns:repeat(3,minmax(0,1fr))}.role-cards{grid-template-columns:repeat(4,minmax(0,1fr))}.rule-card-v2,.role-card-v2{min-height:144px;border:1px solid #e0ecef;border-radius:11px;background:linear-gradient(145deg,#fff,#f9fcfd);padding:16px}.rule-card-v2{position:relative;padding-left:54px}.rule-card-v2:before{position:absolute;top:16px;left:16px;display:grid;width:25px;height:25px;place-items:center;border-radius:8px;color:#0a756d;background:#e2f5ee;font-size:11px;font-weight:850;content:attr(data-number)}.rule-card-v2 h4,.role-card-v2 h4{margin:0 0 7px;color:#17374e;font-size:12px;line-height:1.4}.rule-card-v2 p,.role-card-v2 p{margin:0;color:#657786;font-size:11px;line-height:1.66}.role-card-v2{border-top:3px solid #258ec1}.role-card-v2--manager{border-top-color:#15916f}.role-card-v2--mentor{border-top-color:#9166cf}.role-card-v2--intern{border-top-color:#d59129}.rule-cards--discipline .rule-card-v2{border-top:3px solid #d59129;padding-left:16px}.rule-cards--discipline .rule-card-v2:before{display:none}.rule-cards--discipline .rule-card-v2:nth-child(3){border-top-color:#d25353}.rule-cards--discipline .rule-card-v2:nth-child(4){border-top-color:#7452bc}@media(max-width:980px){.rule-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.role-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.rules-banner__body{align-items:flex-start;flex-direction:column}.rules-banner__stats{width:100%;max-width:250px}}@media(max-width:640px){.rules-banner{padding:21px 18px}.rules-banner h3{font-size:19px}.rule-cards,.role-cards{grid-template-columns:1fr}.rules-section__head{padding:13px 14px}.rule-cards,.role-cards{padding:12px}.rule-card-v2,.role-card-v2{min-height:auto}}
    </style>
</head>
<body class="${pageClass}">
<div class="app-shell">
    <c:choose>
        <c:when test="${roleBase == '/lab-manager'}"><%@ include file="../labmanager/includes/sidebar.jspf"%></c:when>
        <c:when test="${roleBase == '/mentor'}"><%@ include file="../mentor/includes/sidebar.jspf"%></c:when>
        <c:otherwise><%@ include file="../student/includes/sidebar.jspf"%></c:otherwise>
    </c:choose>
    <main class="main-content">
        <header class="topbar"><div class="heading-wrap"><button class="menu-button" id="menuButton" type="button" aria-label="Mở thanh điều hướng" aria-controls="sidebar" aria-expanded="false"><svg><use href="#i-menu"/></svg></button><div><h1>Nội quy phòng lab</h1><p>Quy định sử dụng phòng LAB và trách nhiệm theo từng vai trò</p></div></div><div class="topbar-actions"><div class="top-profile"><div class="avatar">LAB</div><span><c:out value="${currentUser.fullName}"/></span></div></div></header>
        <section class="content-area rules-v2">
            <div class="content-heading"><div><p class="eyebrow">${portalName}</p><h2>Bảng nội quy chung</h2></div></div>
            <section class="rules-banner"><div class="rules-banner__body"><div><span class="rules-banner__tag">HƯỚNG DẪN SỬ DỤNG PHÒNG LAB</span><h3>Giữ LAB an toàn, gọn gàng và sẵn sàng cho mọi người.</h3><p>Mọi thao tác với thiết bị đều cần đúng quyền, đúng quy trình và được ghi nhận minh bạch trên hệ thống.</p></div><div class="rules-banner__stats"><div class="rules-stat"><strong>06</strong><span>Quy tắc chung</span></div><div class="rules-stat"><strong>04</strong><span>Vai trò</span></div></div></div></section>
            <article class="rules-section"><header class="rules-section__head"><span class="rules-section__mark">01</span><div><h3>Quy định áp dụng cho tất cả người dùng</h3><p>Những nguyên tắc cần tuân thủ trước, trong và sau khi sử dụng phòng LAB.</p></div></header><div class="rule-cards"><section class="rule-card-v2" data-number="1"><h4>Ra vào và sử dụng phòng</h4><p>Chỉ sử dụng phòng LAB trong phạm vi được phân quyền, giữ trật tự và không tự ý di chuyển tài sản chung.</p></section><section class="rule-card-v2" data-number="2"><h4>Mượn và trả thiết bị</h4><p>Mọi lượt mượn phải được ghi nhận, dùng đúng mục đích, trả đúng hạn và đúng tình trạng đã nhận.</p></section><section class="rule-card-v2" data-number="3"><h4>Bảo quản tài sản</h4><p>Không tháo lắp, sửa chữa, cài đặt lại hoặc chuyển giao thiết bị khi chưa được người phụ trách đồng ý.</p></section><section class="rule-card-v2" data-number="4"><h4>Báo cáo bất thường</h4><p>Báo ngay khi phát hiện mất mát, hư hỏng, sai số lượng hoặc nguy cơ mất an toàn.</p></section><section class="rule-card-v2" data-number="5"><h4>An toàn và bảo mật</h4><p>Không chia sẻ tài khoản, không để đồ ăn nước uống gần thiết bị và không lưu dữ liệu cá nhân trên máy chung.</p></section><section class="rule-card-v2" data-number="6"><h4>Trách nhiệm cá nhân</h4><p>Người dùng chịu trách nhiệm với tài sản được giao, thông tin đã nhập và thao tác thực hiện bằng tài khoản của mình.</p></section></div></article>
            <article class="rules-section"><header class="rules-section__head"><span class="rules-section__mark">02</span><div><h3>Trách nhiệm theo vai trò</h3><p>Mỗi actor có phạm vi xử lý riêng để vận hành phòng LAB rõ ràng và minh bạch.</p></div></header><div class="role-cards"><section class="role-card-v2"><h4>Quản trị viên</h4><p>Quản lý tài khoản, phân quyền đúng vai trò và phê duyệt danh sách thực tập sinh theo học kỳ.</p></section><section class="role-card-v2 role-card-v2--manager"><h4>Quản lý phòng LAB</h4><p>Theo dõi tài sản, kiểm tra định kỳ, xử lý sự cố nghiêm trọng và quyết định bảo trì hoặc thanh lý.</p></section><section class="role-card-v2 role-card-v2--mentor"><h4>Người hướng dẫn</h4><p>Hướng dẫn sử dụng thiết bị, quản lý thực tập sinh, xác minh sự cố và lập kết luận trách nhiệm.</p></section><section class="role-card-v2 role-card-v2--intern"><h4>Thực tập sinh</h4><p>Mượn đúng nhu cầu, dùng cẩn thận, trả đúng hạn và báo cáo trung thực mọi sự cố phát sinh.</p></section></div></article>
            <article class="rules-section"><header class="rules-section__head"><span class="rules-section__mark">03</span><div><h3>Quy chế xử lý vi phạm</h3><p>Mức xử lý dựa trên mức độ ảnh hưởng và kết quả xác minh của người phụ trách.</p></div></header><div class="rule-cards rule-cards--discipline"><section class="rule-card-v2"><h4>Vi phạm nhẹ</h4><p>Được nhắc nhở và ghi nhận theo dõi khi vi phạm nội quy lần đầu hoặc chưa cập nhật đầy đủ trạng thái sử dụng.</p></section><section class="rule-card-v2"><h4>Hư hỏng nhẹ</h4><p>Mentor có thể xử lý an toàn và hướng dẫn lại người dùng; không cần lập sự cố gửi Lab Manager.</p></section><section class="rule-card-v2"><h4>Sự cố nghiêm trọng</h4><p>Mất thiết bị, hư hỏng không thể tự sửa hoặc nguy cơ mất an toàn phải báo ngay cho Lab Manager.</p></section><section class="rule-card-v2"><h4>Đền bù và hạn chế quyền</h4><p>Quyết định dựa trên kết luận xác minh; trường hợp lặp lại hoặc cố ý có thể bị tạm dừng quyền mượn.</p></section></div></article>
        </section>
    </main>
</div>
</body>
</html>
