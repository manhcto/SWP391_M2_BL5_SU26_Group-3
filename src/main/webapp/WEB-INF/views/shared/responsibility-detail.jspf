<%@ page pageEncoding="UTF-8" %>
<article class="panel">
    <div class="form-grid">
        <div class="form-group"><label>Mã trách nhiệm</label><input class="form-control readonly-field" value="#<c:out value='${responsibility.responsibilityCode}'/>" readonly></div>
        <div class="form-group"><label>Trạng thái</label><input class="form-control readonly-field" value="<c:out value='${app:label(responsibility.status)}'/>" readonly></div>
        <div class="form-group"><label>Thực tập sinh</label><input class="form-control readonly-field" value="<c:out value='${responsibility.internName}'/> (<c:out value='${responsibility.internCode}'/>)" readonly></div>
        <div class="form-group"><label>Email thực tập sinh</label><input class="form-control readonly-field" value="<c:out value='${responsibility.internEmail}'/>" readonly></div>
        <div class="form-group"><label>Người xác định</label><input class="form-control readonly-field" value="<c:out value='${responsibility.mentorName}'/>" readonly></div>
        <div class="form-group"><label>Xác định lúc</label><input class="form-control readonly-field" value="<c:out value='${app:dateTime(responsibility.determinedAt)}'/>" readonly></div>
    </div>
</article>

<div class="detail-columns">
    <article class="panel">
        <div class="panel-header"><div><h3>Sự cố và bằng chứng liên quan</h3><p>Thông tin sự cố được sử dụng trong quá trình điều tra</p></div></div>
        <div class="form-grid">
            <div class="form-group"><label>Mã sự cố</label><input class="form-control readonly-field" value="<c:out value='${responsibility.incidentCode}'/>" readonly></div>
            <div class="form-group"><label>Loại / Mức độ</label><input class="form-control readonly-field" value="<c:out value='${app:label(responsibility.incidentType)}'/> / <c:out value='${app:label(responsibility.incidentSeverity)}'/>" readonly></div>
            <div class="form-group"><label>Trạng thái sự cố</label><input class="form-control readonly-field" value="<c:out value='${app:label(responsibility.incidentStatus)}'/>" readonly></div>
            <div class="form-group"><label>Xảy ra / Báo cáo</label><input class="form-control readonly-field" value="<c:out value='${app:dateTime(responsibility.occurredAt)}'/> / <c:out value='${app:dateTime(responsibility.reportedAt)}'/>" readonly></div>
            <div class="form-group full-width"><label>Bằng chứng / Mô tả sự cố</label><textarea class="form-control readonly-field" readonly><c:out value="${responsibility.incidentDescription}"/></textarea></div>
            <div class="form-group full-width"><label>Ghi chú điều tra</label><textarea class="form-control readonly-field" readonly><c:out value="${responsibility.investigationNote}" default="Không có ghi chú điều tra."/></textarea></div>
            <div class="form-group full-width"><label>Kết quả xử lý sự cố</label><textarea class="form-control readonly-field" readonly><c:out value="${responsibility.handlingResult}" default="Không có kết quả xử lý."/></textarea></div>
        </div>
    </article>

    <article class="panel">
        <div class="panel-header"><div><h3>Lượt sử dụng thiết bị liên quan</h3><p>Lịch sử thiết bị và mượn có thể truy vết</p></div></div>
        <div class="form-grid">
            <div class="form-group"><label>Thiết bị</label><input class="form-control readonly-field" value="<c:out value='${responsibility.assetName}'/> (<c:out value='${responsibility.assetCode}'/>)" readonly></div>
            <div class="form-group"><label>Mã lượt sử dụng / Trạng thái</label><input class="form-control readonly-field" value="#AU-${responsibility.assetUsageId} / <c:out value='${app:label(responsibility.usageStatus)}'/>" readonly></div>
            <div class="form-group"><label>Mượn lúc</label><input class="form-control readonly-field" value="<c:out value='${app:dateTime(responsibility.borrowedAt)}'/>" readonly></div>
            <div class="form-group"><label>Hạn trả</label><input class="form-control readonly-field" value="<c:out value='${app:dateTime(responsibility.dueAt)}'/>" readonly></div>
            <div class="form-group full-width"><label>Trả lúc</label><input class="form-control readonly-field" value="<c:out value='${app:dateTime(responsibility.returnedAt)}'/>" readonly></div>
        </div>
    </article>
</div>

<article class="panel">
    <div class="panel-header"><div><h3>Kết quả trách nhiệm và quyết định xử lý</h3><p>Kết luận, bồi thường hoặc hướng giải quyết của người hướng dẫn</p></div></div>
    <div class="form-grid">
        <div class="form-group full-width"><label>Kết luận của người hướng dẫn</label><textarea class="form-control readonly-field" readonly><c:out value="${responsibility.conclusion}"/></textarea></div>
        <div class="form-group full-width"><label>Đề xuất xử lý / Bồi thường</label><textarea class="form-control readonly-field" readonly><c:out value="${responsibility.decision}" default="Không có yêu cầu bồi thường hoặc xử lý."/></textarea></div>
        <div class="form-group full-width"><label>Ghi chú giải quyết</label><textarea class="form-control readonly-field" readonly><c:out value="${responsibility.resolutionNote}" default="Không có ghi chú giải quyết."/></textarea></div>
        <c:if test="${not empty responsibility.reviewerName}">
            <div class="form-group"><label>Người duyệt</label><input class="form-control readonly-field" value="<c:out value='${responsibility.reviewerName}'/>" readonly></div>
            <div class="form-group"><label>Duyệt lúc</label><input class="form-control readonly-field" value="<c:out value='${app:dateTime(responsibility.reviewedAt)}'/>" readonly></div>
            <div class="form-group full-width"><label>Quyết định của quản lý</label><textarea class="form-control readonly-field" readonly><c:out value="${responsibility.reviewNote}" default="Không có ghi chú của quản lý."/></textarea></div>
        </c:if>
    </div>
</article>
