<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="app" uri="/WEB-INF/app.tld" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thiết bị được cấp | LAB Asset</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mentor-dashboard.css"></head>
<body class="intern-dashboard-page"><c:set var="activeMenu" value="allocations" scope="request"/><div class="app-shell"><%@ include file="../../student/includes/sidebar.jspf" %><main class="main-content"><header class="topbar"><div class="heading-wrap"><button class="menu-button" id="menuButton" type="button" aria-label="Mở thanh điều hướng"><svg><use href="#i-menu"/></svg></button><div><h1>Thiết bị được cấp</h1><p>Xác nhận bàn giao và báo sự cố cho Mentor</p></div></div></header>
<section class="content-area"><c:if test="${not empty param.error}"><p class="error-message"><c:out value="${param.error}"/></p></c:if><c:if test="${param.success == '1'}"><p class="success-message">Đã cập nhật thông tin thiết bị.</p></c:if><article class="panel"><div class="table-scroll"><table><thead><tr><th>Hoạt động</th><th>Thiết bị</th><th>Đối tượng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${allocations}" var="allocation"><tr><td><c:out value="${allocation.activityName}"/></td><td><strong><c:out value="${allocation.assetName}"/></strong><br><small><c:out value="${allocation.itemCode}"/></small></td><td><c:out value="${allocation.targetName}"/></td><td><span class="status"><c:out value="${app:label(allocation.status)}"/></span></td><td><c:if test="${allocation.status == 'READY_FOR_HANDOVER'}"><form method="post"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="receive"><input type="hidden" name="allocationId" value="${allocation.allocationId}"><button class="primary-button" type="submit">Xác nhận nhận</button></form></c:if><c:if test="${allocation.status == 'ACTIVE'}"><details><summary>Báo sự cố</summary><form method="post" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="reportIssue"><input type="hidden" name="allocationId" value="${allocation.allocationId}"><select class="form-control" name="issueType" required><option value="DAMAGE">Hư hỏng</option><option value="LOSS">Mất thiết bị</option><option value="MISSING_COMPONENT">Thiếu thành phần</option></select><textarea class="form-control" name="description" rows="2" required placeholder="Mô tả sự cố"></textarea><input class="form-control" type="file" name="image" accept="image/png,image/jpeg,image/webp"><button class="primary-button" type="submit">Gửi Mentor</button></form></details></c:if></td></tr></c:forEach></tbody></table></div></article></section></main></div></body></html>
